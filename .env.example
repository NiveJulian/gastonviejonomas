# ==============================================================================
# GASTONAPP - PLANTILLA DE VARIABLES DE ENTORNO (OPEN SOURCE / DOKPLOY)
# ==============================================================================
# Copia este archivo como .env para desarrollo local o define estas variables
# directamente en el panel de Dokploy (Project -> Application -> Environment).

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP (DOKPLOY / DOCKER)
# ------------------------------------------------------------------------------
# Puerto en el que escucha el servidor de producción (por defecto 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN GOOGLE CLOUD OAUTH 2.0 (RECOMENDADO)
# ------------------------------------------------------------------------------
# ID de cliente de aplicación web de Google Cloud Console.
# Permite autenticar al usuario y sincronizar con su propia hoja de Google Sheets y Drive.
# Obtén este valor en https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. PROVEEDOR LLM / INTELIGENCIA ARTIFICIAL (OPCIONAL)
# ------------------------------------------------------------------------------
# Endpoint compatible con la API de OpenAI (OpenAI, Ollama, Groq, vLLM, OpenRouter, etc.)
# Ejemplo OpenAI: https://api.openai.com/v1
# Ejemplo Ollama local: http://host.docker.internal:11434/v1
VITE_OMNIROUTE_BASE_URL=

# Clave API del proveedor LLM
VITE_OMNIROUTE_API_KEY=

# Nombre del modelo a utilizar
VITE_OMNIR_MODEL=auto/best-fast

# ------------------------------------------------------------------------------
# 4. AGENTE DE TELEGRAM EN SEGUNDO PLANO (OPCIONAL)
# ------------------------------------------------------------------------------
# Token del bot creado con @BotFather en Telegram.
# Si se define, el contenedor levantará automáticamente el agente de Telegram
# en segundo plano para procesar comprobantes, gastos y consultas 24/7.
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 5. GOOGLE APPS SCRIPT WEB APP (OPCIONAL)
# ------------------------------------------------------------------------------
# URL del Web App de Google Apps Script si utilizas el flujo sin OAuth directo.
VITE_APPS_SCRIPT_URL=
