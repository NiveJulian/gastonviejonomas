# ===================================================
# FINANZAHOGAR - VARIABLES DE ENTORNO
# ===================================================

# 1. Google Cloud Console (OAuth 2.0 Client ID)
# Obtén este ID en https://console.cloud.google.com/ -> Credenciales -> ID de cliente de OAuth (Aplicación web)
VITE_GOOGLE_CLIENT_ID=

# 2. Servidor LLM / Agente propio (Compatible con API de OpenAI, Ollama, vLLM u Omniroute)
VITE_OMNIROUTE_BASE_URL=
VITE_OMNIROUTE_API_KEY=
VITE_OMNIR_MODEL=gpt-4o-mini
